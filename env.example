# Postgres connection string (Neon in prod, local docker-compose postgres in dev)
DATABASE_URL=postgres://webhook_relay:webhook_relay@localhost:5432/webhook_relay?sslmode=disable

# Redis (Upstash/Redis Cloud in prod, local docker-compose redis in dev)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Port the Fiber API listens on
API_PORT=8080

# HMAC signing (Phase 2)
# Outbound: signs the X-Webhook-Signature header on every delivery to a
# target_url, so receivers can verify it came from this relay. If empty,
# outbound requests are sent unsigned.
OUTBOUND_SIGNING_SECRET=change-me-to-a-long-random-string

# Inbound: if set, POST /api/v1/webhooks requires a valid X-Webhook-Signature
# header signed with this secret. Leave empty to accept unsigned requests
# (e.g. local development, or a trusted single-publisher setup).
INBOUND_SIGNING_SECRET=
